# Copy to `.env` and fill in values.
# Live HostNext: use cPanel MySQL hostname (not 127.0.0.1 from your PC).

NODE_ENV=development
PORT=5000

DB_HOST=h40.eu.core.hostnext.net
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=petzonep_software

# Queue Management database (separate DB, same HostNext credentials)
QUEUE_DB_NAME=petzonep_queue-management

JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-too

CORS_ORIGIN=http://localhost:3000

# High load (production / cPanel)
DB_POOL_LIMIT=50
DB_QUEUE_LIMIT=200
LEDGER_MIGRATION_CACHE_MS=30000

# Allow inventory to go negative on sales; completing a PO adds qty back (opening + PO - sold + returns)
INVENTORY_ALLOW_NEGATIVE_STOCK=true

# Queue Management SSO (same pattern as LabelPress)
# QMS_API_URL=https://queue-management.petzone.pk
# QMS_APP_URL=https://queue-management.petzone.pk
# QMS_SSO_SECRET=petzone-qms-sso-shared-secret
# Production:
# BARCODE_API_URL=https://barcode-printer.petzone.pk
# BARCODE_APP_URL=https://barcode-printer.petzone.pk
# BARCODE_SSO_SECRET=petzone-barcode-sso-shared-secret
BARCODE_API_URL=http://localhost:5055
BARCODE_APP_URL=http://localhost:5055
BARCODE_SSO_SECRET=petzone-barcode-sso-shared-secret
